# ZeroCrawl Configuration
# Copy to .env and adjust as needed

# Browser pool size (auto-detected from RAM if not set)
# ZEROCRAWL_BROWSER_POOL_SIZE=1

# Default scrape mode: auto | fast | browser | aggressive
ZEROCRAWL_DEFAULT_MODE=auto

# Request timing (seconds)
ZEROCRAWL_DELAY_MEAN_SECONDS=2.0
ZEROCRAWL_DELAY_STDDEV_SECONDS=1.0
ZEROCRAWL_DELAY_MIN_SECONDS=0.5
ZEROCRAWL_REQUESTS_PER_SECOND_PER_DOMAIN=1.0

# Default timeouts
ZEROCRAWL_DEFAULT_TIMEOUT=60
ZEROCRAWL_DEFAULT_CACHE_TTL=3600

# Storage
ZEROCRAWL_DATA_DIR=.zerocrawl

# API server
ZEROCRAWL_API_HOST=127.0.0.1
ZEROCRAWL_API_PORT=8765

# Logging
ZEROCRAWL_LOG_LEVEL=INFO

# AI providers (optional)
# ZEROCRAWL_OLLAMA_HOST=http://localhost:11434
# ZEROCRAWL_OPENAI_API_KEY=sk-...
# ZEROCRAWL_ANTHROPIC_API_KEY=sk-ant-...
# ZEROCRAWL_GEMINI_API_KEY=AIza...

# Proxy (optional)
# ZEROCRAWL_PROXY_STRATEGY=own_ip
# ZEROCRAWL_CUSTOM_PROXY=http://user:pass@host:port
