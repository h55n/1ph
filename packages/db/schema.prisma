generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Hackathon {
  id                String       @id @default(uuid())
  title             String
  slug              String       @unique
  organizerName     String
  organizerLogoUrl  String?
  description       String
  longDescription   String?
  themeTags         String[]
  mode              Mode
  entryFee          Decimal?     @db.Decimal(10, 2)
  entryFeeCurrency  String?      @default("USD")
  teamSizeMin       Int          @default(1)
  teamSizeMax       Int?
  eligibility       Eligibility
  durationType      DurationType
  prizePool         Decimal?     @db.Decimal(12, 2)
  prizeCurrency     String?      @default("USD")
  prizeDescription  String?
  registrationOpen  DateTime?
  registrationClose DateTime
  eventStart        DateTime
  eventEnd          DateTime?
  applyUrl          String
  source            Source
  sourceId          String?
  scope             Scope
  indiaRegion       String?
  prestigeTier      PrestigeTier @default(T3)
  sponsors          String[]
  status            HackStatus   @default(UPCOMING)
  isVerified        Boolean      @default(false)
  isFeatured        Boolean      @default(false)
  urlHealthFails    Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  lastSyncedAt      DateTime?
  bookmarks         Bookmark[]
  registrations     Registration[]

  @@unique([source, sourceId])
  @@index([status])
  @@index([scope])
  @@index([prestigeTier])
  @@index([registrationClose])
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  password  String?
  avatarUrl String?
  role      UserRole   @default(VISITOR)
  provider  Provider
  createdAt DateTime   @default(now())
  accounts  Account[]
  bookmarks     Bookmark[]
  registrations Registration[]
  sessions      Session[]
}

model Bookmark {
  id          String    @id @default(uuid())
  userId      String
  hackathonId String
  createdAt   DateTime  @default(now())
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hackathonId])
}

model Registration {
  id          String    @id @default(uuid())
  userId      String
  hackathonId String
  createdAt   DateTime  @default(now())
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hackathonId])
}

model OrganizerSubmission {
  id             String           @id @default(uuid())
  submittedBy    String
  orgName        String
  orgWebsite     String
  hackathonTitle String
  applyUrl       String
  rawFormData    Json
  status         SubmissionStatus @default(PENDING)
  adminNotes     String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
}

model PipelineRun {
  id           String         @id @default(uuid())
  source       Source
  runAt        DateTime       @default(now())
  status       PipelineStatus
  newCount     Int            @default(0)
  updatedCount Int            @default(0)
  closedCount  Int            @default(0)
  errorLog     String?

  @@index([runAt])
  @@index([source])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Mode {
  ONLINE
  OFFLINE
  HYBRID
}

enum Eligibility {
  STUDENTS
  OPEN
  PROFESSIONALS
}

enum DurationType {
  HR24
  HR48
  WEEK
  MONTH
  CUSTOM
}

enum Source {
  DEVPOST
  DEVFOLIO
  MLH
  UNSTOP
  DORAHACKS
  HACKEREARTH
  STARTUP_INDIA
  HACK2SKILL
  HACKERRANK
  LUMA
  TOPLANG
  MANUAL
}

enum Scope {
  GLOBAL
  INDIA
}

enum PrestigeTier {
  T1
  T2
  T3
}

enum HackStatus {
  UPCOMING
  OPEN
  CLOSING_SOON
  CLOSED
}

enum UserRole {
  VISITOR
  ADMIN
}

enum Provider {
  GOOGLE
  GITHUB
  CREDENTIALS
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PipelineStatus {
  SUCCESS
  PARTIAL
  FAILED
}
